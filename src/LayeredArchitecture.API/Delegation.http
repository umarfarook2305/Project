### ============================================
### UPDATE DELEGATE ENDPOINTS
### ============================================

### Update Delegate - Full Update
PUT {{baseUrl}}/api/Delegation/UpdateDelegate
Content-Type: application/json

{
  "delegateId": "9ea2c965-ca55-f111-a824-000d3a3df5a3",
  "behalfUserEmail": "akshaysreekrishna.mariappan@kumaran.com",
  "behalfUser": "Akshaysreekrishna Mariappan",
  "delegatedByEmail": "akshaysreekrishna.mariappan@kumaran.com",
  "delegatedBy": "Akshaysreekrishna Mariappan",
  "delegateUserEmail": "vignesh.kumaresan@kumaran.com",
  "delegateUser": "Vignesh Kumaresan",
  "delegationStatus": true,
  "delegatedOn": "2026-05-22",
  "delegateFrom": "2026-05-22",
  "delegateTo": "2110-06-30"
}

###

### Update Delegate - Partial Update (Dates Only)
PUT {{baseUrl}}/api/Delegation/UpdateDelegate
Content-Type: application/json

{
  "delegateId": "9ea2c965-ca55-f111-a824-000d3a3df5a3",
  "delegateFrom": "2026-06-01",
  "delegateTo": "2026-12-31"
}

###

### Update Delegate - Partial Update (Emails Only)
PUT {{baseUrl}}/api/Delegation/UpdateDelegate
Content-Type: application/json

{
  "delegateId": "9ea2c965-ca55-f111-a824-000d3a3df5a3",
  "delegateUserEmail": "new.delegate@kumaran.com",
  "behalfUserEmail": "new.behalf@kumaran.com"
}

###

### Update Delegate - Invalid GUID (400 Bad Request)
PUT {{baseUrl}}/api/Delegation/UpdateDelegate
Content-Type: application/json

{
  "delegateId": "invalid-guid",
  "delegateFrom": "2026-06-01"
}

###

### Update Delegate - Non-existent Delegate (404 Not Found)
PUT {{baseUrl}}/api/Delegation/UpdateDelegate
Content-Type: application/json

{
  "delegateId": "00000000-0000-0000-0000-000000000000",
  "delegateFrom": "2026-06-01"
}

